<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
			Multi-targets both TFMs the library ships so the net8.0 assets in the
			package are actually exercised, not just compiled.
		-->
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<!-- xUnit v3 test projects are self-executing host processes. -->
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!--
			CA1707 (no underscores in member names) is the xUnit-naming
			convention everyone uses for readable test names like
			Method_when_condition_expected_result. Let tests use it.

			CA1515 (internal > public) would flag every xUnit fixture —
			tests need to be public for the runner to discover them.

			CA2007 (ConfigureAwait) doesn't apply in test contexts; there
			is no SynchronizationContext to recapture.
		-->
		<NoWarn>$(NoWarn);CA1707;CA1515;CA2007</NoWarn>
	</PropertyGroup>

	<!--
		xUnit v3 runs on Microsoft.Testing.Platform: the test project is its own
		host process, so the VSTest-era packages (Microsoft.NET.Test.Sdk,
		xunit.runner.visualstudio, coverlet.collector) are gone — the .NET 10 SDK
		no longer supports testing through the VSTest bridge at all. `dotnet test`
		is pointed at MTP by the `test.runner` setting in global.json.
	-->
	<ItemGroup>
		<PackageReference Include="xunit.v3" Version="4.0.0" />
		<PackageReference Include="Spectre.Console.Testing" Version="0.57.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\NextIteration.SpectreConsole.SelfUpdate\NextIteration.SpectreConsole.SelfUpdate.csproj" />
	</ItemGroup>

</Project>
